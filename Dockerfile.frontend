# Dockerfile.frontend
FROM node:20 AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build \
 && if [ -d "dist" ]; then mv dist site; fi \
 && if [ -d "build" ]; then mv build site; fi

FROM nginx:alpine
COPY --from=builder /app/site /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
